# Required for any non-local deployment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
ENVIRONMENT=development

# PostgreSQL (docker-compose uses these values)
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://nexus:replace-with-a-strong-database-password@localhost:5432/nexus

# LLM and embeddings are optional for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional provider connectors.
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
NEXUS_CONTACT_EMAIL=
